      "expressions": [
        "M(q) = m_1 J_{v1}^{T} J_{v1} + m_2 J_{v2}^{T} J_{v2} + \\begin{bmatrix} I_1 + I_2 & I_2 \\\\ I_2 & I_2 \\end{bmatrix}"
      ]
