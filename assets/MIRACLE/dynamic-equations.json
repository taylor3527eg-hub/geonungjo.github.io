      "expressions": [
        "C(q,\\dot{q}) = \\begin{bmatrix} -h\\dot{q}_2 & -h(\\dot{q}_1 + \\dot{q}_2) \\\\ h\\dot{q}_1 & 0 \\end{bmatrix}",
